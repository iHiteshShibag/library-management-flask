SECRET_KEY=your-secret-key-here
FLASK_DEBUG=false
DATABASE_URL=postgresql://library:library_dev_pw@localhost:5432/library
# Optional: without these, password-reset links and due-date reminders are
# logged/flashed to the screen instead of emailed (see mailer.py).
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Set to true only once the app is served over HTTPS — until then, turning
# this on will break login (browsers won't send a Secure cookie over http://).
SESSION_COOKIE_SECURE=false

# Rate-limit counters storage. The default (in-process memory) is only
# correct when running a single worker process. If you run more than one
# worker (e.g. `gunicorn -w 4`), point this at a shared store instead, or
# each worker enforces its own separate limit:
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# Optional: error tracking. Leave unset to skip Sentry entirely.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Socket.IO CORS — leave unset (same-origin only) for local dev.
# In production set this to your domain: https://library.example.com
# Separate multiple origins with commas.
# SOCKETIO_CORS_ALLOWED_ORIGINS=https://library.example.com

# Socket.IO message queue — required when running more than one Gunicorn
# worker so all workers share broadcast events.
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379
